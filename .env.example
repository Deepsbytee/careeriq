# ── CareerIQ environment ─────────────────────────────────────
# Copy this file to `.env` (in this folder) and fill in your values.
# Never commit `.env`: it holds secrets.

# Database. Leave empty to use a local SQLite file (backend/careeriq.db).
# Production example: postgresql+psycopg2://career:career@postgres:5432/careerdb
DATABASE_URL=

# "development" or "production". Production refuses to start with a weak SECRET_KEY
# and turns the demo accounts off.
ENVIRONMENT=development

# Demo accounts (candidate@, recruiter@, admin@example.com). Leave empty to use the default:
# on in development, off in production. Set true/false to force it.
DEMO_MODE=
DEMO_PASSWORD=DemoPass123!

# Security / JWT. Generate a real one (32+ characters required in production):  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── AI provider ──────────────────────────────────────────────
# One of: gemini | ollama | openai | anthropic
AI_PROVIDER=gemini

# Gemini (free tier): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# "gemini-flash-latest" always points at the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Ollama (free, unlimited, runs on your own machine): https://ollama.com
#   ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Paid options
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Abuse protection (per server process) ─────────────────────
AUTH_ATTEMPTS_PER_MINUTE=10
AI_BURST_PER_MINUTE=8
AI_DAILY_LIMIT=40

# ── Uploads ──────────────────────────────────────────────────
MAX_UPLOAD_MB=5
MAX_RESUME_PAGES=6

# Optional: lifts GitHub's anonymous limit (60/hour) for the Portfolio analyzer.
GITHUB_TOKEN=
